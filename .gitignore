# build / runtime
api/bin/
api/data/
*.db
*.db-shm
*.db-wal

# spike: receipt images and OCR caches stay local
spike/receipts/
spike/ocr/
spike/results.csv

# python
__pycache__/
*.pyc
.venv/

# xcode
ios/**/xcuserdata/
ios/**/DerivedData/
*.xcuserstate

.DS_Store

# local backups (dev default for SHOP_BACKUP_DIR)
backups/

# local secrets (LOGO_DEV_TOKEN etc.); see deploy/.env.example
deploy/.env
.env

# spike: real receipt photos and OCR output of them stay local
spike/data/
spike/out/

# agents' working notes (local only)
notes/

# optional off-site copy (rclone): config and secrets stay local
deploy/offsite/config/*
!deploy/offsite/config/.gitkeep
!deploy/offsite/config/README
deploy/offsite/offsite.env

# per-developer build overrides (see ios/Shop/Config/Shop.xcconfig)
ios/Shop/Config/Local.xcconfig

deploy/hosted/.env
deploy/hosted/offsite.env
deploy/hosted/offsite.env.new
deploy/hosted/secrets.env
deploy/hosted/.deploy/
