# Copy to deploy/hosted/secrets.env, `chmod 600 secrets.env`. Git-ignored. One KEY=value per line,
# no quotes. deploy.sh preflight requires every line below. Keep a copy of the SEALER key in a
# password manager: without it the stored Sign in with Apple refresh tokens cannot be read.

# 32 random bytes as 64 hex characters: openssl rand -hex 32
SHOP_SEALER_KEY=CHANGE_ME

# sha256 of the admin API token. Make a token and its hash with
#   ./compose.sh run --rm --no-deps api admin token create
# (the token is printed once; the admin API itself is not reachable from outside the container).
ADMIN_TOKEN_HASH=CHANGE_ME

# The two Apple .p8 keys (PKCS#8 PEM, P-256) on ONE line each, with \n for the line breaks:
#   awk 'NF {printf "%s\\n", $0}' AuthKey_XXXX.p8
SHOP_APPLE_SIWA_KEY=CHANGE_ME
SHOP_APPLE_IAP_KEY=CHANGE_ME
