# Copy to deploy/.env (git-ignored) and fill in. docker compose reads it automatically.

# logo.dev publishable key (pk_…) for shop logos. Leave empty to show monograms.
LOGO_DEV_TOKEN=

# Host path of the backup folder: a local folder, an external disk or a network mount
# (default: ../backups). Nothing here requires a NAS.
# SHOP_BACKUP_DIR=/Volumes/backups/shop

# Automatic products: confirming a receipt links/creates products. On by default; set off to disable
# (docs/PRODUCT-AUTOPOPULATE.md).
AUTO_PRODUCTS=on

# Optional off-site copy (rclone). Start it with `make offsite-up`. Everything is optional;
# nothing is needed for local backups. Put keys and passwords in deploy/offsite/offsite.env
# (git-ignored), not here. See docs/operations.md.
# OFFSITE_REMOTE=shopcrypt:shop     # an rclone remote name + path; use a crypt remote for any cloud
# OFFSITE_PRUNE=on                  # on: remove old snapshots off-site as locally; off: keep all
# OFFSITE_RCLONE_FLAGS=--bwlimit 2M
