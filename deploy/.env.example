# Copy to deploy/.env (git-ignored) and fill in. docker compose reads it automatically.

# logo.dev publishable key (pk_…) for shop logos. Leave empty to show monograms.
LOGO_DEV_TOKEN=

# Host path of the NAS mount for backups (default: ../backups).
# SHOP_BACKUP_DIR=/Volumes/backups/shop

# Automatic products. Leave off until the dry-run backfill and the first receipts have been checked
# (docs/PRODUCT-AUTOPOPULATE.md section 8).
AUTO_PRODUCTS=off
