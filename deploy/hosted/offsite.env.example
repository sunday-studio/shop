# Copy to deploy/hosted/offsite.env (mode 600, git-ignored). Credentials for the encrypted off-site copy.
# Passwords must be in rclone's OBSCURED form: ./deploy.sh gen-offsite prints a ready file.
# KEEP A COPY OF THE CRYPT PASSWORD AND SALT OFF THIS SERVER (password manager): without them the
# backups cannot be read, by you or anyone else.

# Real storage: any S3-compatible bucket, e.g. UpCloud Managed Object Storage (EU).
RCLONE_CONFIG_STORE_TYPE=s3
RCLONE_CONFIG_STORE_PROVIDER=Other
RCLONE_CONFIG_STORE_ENDPOINT=https://CHANGE_ME.upcloudobjects.com
RCLONE_CONFIG_STORE_ACCESS_KEY_ID=CHANGE_ME
RCLONE_CONFIG_STORE_SECRET_ACCESS_KEY=CHANGE_ME
# Encryption layer. OFFSITE_REMOTE in .env points at this one.
RCLONE_CONFIG_SHOPCRYPT_TYPE=crypt
RCLONE_CONFIG_SHOPCRYPT_REMOTE=store:CHANGE_ME_BUCKET/shop
RCLONE_CONFIG_SHOPCRYPT_PASSWORD=CHANGE_ME
RCLONE_CONFIG_SHOPCRYPT_PASSWORD2=CHANGE_ME
