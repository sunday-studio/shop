# Copy to deploy/hosted/.env on the server, `chmod 600 .env`, and fill in.
# Git-ignored. No real secret belongs in this template. Runbook: deploy/hosted/RUNBOOK.md.

# --- Where it lives -------------------------------------------------------------
SHOP_DOMAIN=shop.example.com            # DNS A/AAAA record must point at this server before the first deploy
ACME_EMAIL=ops@example.com              # Let's Encrypt expiry notices

# --- Images (pinned by tag; never latest) --------------------------------------
SHOP_API_TAG=CHANGE_ME                  # e.g. 1.2.0 (ghcr.io/sunday-studio/shop-api tags: x.y.z, x.y, sha-...)
# SHOP_API_IMAGE=ghcr.io/sunday-studio/shop-api   # the private hosted image goes here, plus `docker login` on the server
SHOP_OCR_TAG=ppocrv5                    # pin to a version tag or digest once one is published
# SHOP_OCR_IMAGE=ghcr.io/sunday-studio/shop-ocr

# --- Apple (see api/internal/hosted/APPLE.md for where each value comes from) -------
# The image runs the hosted server (shop-hosted), not the single-household one. The values below
# are IDs, not secrets. The secrets (keys) go in secrets.env, see secrets.env.example.
SHOP_APPLE_BUNDLE_ID=com.sundaystudi.Shop
SHOP_APPLE_TEAM_ID=CHANGE_ME            # 10 characters, Membership page
SHOP_APPLE_APP_ID=CHANGE_ME             # numeric Apple ID of the app in App Store Connect
SHOP_APPLE_SIWA_KEY_ID=CHANGE_ME        # key id of the Sign in with Apple key
SHOP_APPLE_IAP_KEY_ID=CHANGE_ME         # key id of the In-App Purchase key
SHOP_APPLE_IAP_ISSUER_ID=CHANGE_ME      # issuer id, top of the In-App Purchase key page
SHOP_APPLE_PRODUCT_IDS=com.sundaystudi.shop.hosted.monthly   # comma separated allow-list
# production = real endpoints only (the default). sandbox = a staging server.
SHOP_APPLE_ENVIRONMENT=production
# App Review and TestFlight testers buy in the Apple SANDBOX against this server. true (default)
# accepts those purchases but flags them (environment=sandbox), caps them at SHOP_APPLE_SANDBOX_MAX_DAYS
# and never counts them as revenue; false refuses them. Leave it true during beta and App Review;
# turn it off after launch if no TestFlight testing is needed any more.
SHOP_APPLE_ACCEPT_SANDBOX=true
SHOP_APPLE_SANDBOX_MAX_DAYS=30
# The admin API is not published at all; operators use `./compose.sh exec api shop-hosted admin ...`.
# Secrets for the hosted server (SHOP_SEALER_KEY, ADMIN_TOKEN_HASH, the two Apple keys) go in
# deploy/hosted/secrets.env (mode 600, git-ignored): copy secrets.env.example.

# --- Optional app settings --------------------------------------------------------
LOGO_DEV_TOKEN=                         # logo.dev publishable key; empty = monograms
AUTO_PRODUCTS=on

# --- Memory budget (see CAPACITY.md) ---------------------------------------------
OCR_MEM_LIMIT=3g
API_MEM_LIMIT=768m

# --- Backups ----------------------------------------------------------------------
BACKUP_AT=03:30                         # Europe/Amsterdam
BACKUP_KEEP_DAYS=30
# Off-site copy is mandatory. OFFSITE_REMOTE names an rclone CRYPT remote defined in offsite.env.
OFFSITE_REMOTE=shopcrypt:shop
OFFSITE_LABEL=offsite-crypt             # shown in the off-site status file; no secrets
OFFSITE_PRUNE=on

# --- Monitoring (all optional, free; see RUNBOOK.md "Monitoring") -------------------
MONITOR_INTERVAL=300                    # seconds between checks
DISK_ALERT_PCT=80
QUEUE_ALERT_PENDING=15                  # alert when more than this many jobs are queued/running ...
QUEUE_ALERT_CHECKS=3                    # ... for this many checks in a row
ALERT_REPEAT_HOURS=6
# Webhook: ntfy.sh topic, Slack/Discord/Mattermost incoming webhook, or your own endpoint.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=json               # json = {"text":..,"content":..} (Slack, Discord, Mattermost); text = plain body (ntfy)
# Email through any SMTP server you already have (curl speaks SMTP):
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_URL=                               # e.g. smtps://smtp.example.com:465
SMTP_USER=
SMTP_PASSWORD=
# Dead-man's switch: the monitor pings this URL after every good check (healthchecks.io free tier,
# or any "ping me or I alert you" service). The only thing that notices a dead server.
HEALTHCHECKS_PING_URL=
